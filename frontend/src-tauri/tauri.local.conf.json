{
  "productName": "AiGoodMeeting",
  "identifier": "com.meetily.local-speakers",
  "build": {
    "beforeBuildCommand": "node node_modules/next/dist/bin/next build"
  },
  "app": {
    "windows": [
      {
        "title": "AiGoodMeeting",
        "width": 1240,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "theme": null,
        "decorations": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["hudWindow"],
          "state": "followsWindowActiveState"
        },
        "minWidth": 760,
        "minHeight": 580
      }
    ]
  },
  "bundle": {
    "targets": [
      "app"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/aigoodbro.icns"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": []
    }
  }
}
